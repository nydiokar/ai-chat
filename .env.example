# AI Chat Bot Environment Configuration
# Copy this file to .env and fill in your actual values

# ==========================================
# INSTANCE CONFIGURATION
# ==========================================
INSTANCE_ID=development
NODE_ENV=development

# ==========================================
# AI SERVICES CONFIGURATION
# ==========================================

# OpenAI Configuration
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-3.5-turbo-0125
OPENAI_TEMPERATURE=0.7
OPENAI_MAX_RETRIES=3

# Anthropic Configuration (for Claude models)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Ollama Configuration (for local AI models)
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:latest

# ==========================================
# TREE-OF-THOUGHT PLANNING CONFIGURATION
# ==========================================
# Enable/disable Tree-of-Thought pre-planning (set to 'false' for traditional ReAct)
ENABLE_TOT_PLANNING=false

# Model to use for planning stages (recommended: gpt-3.5-turbo for cost efficiency)
TOT_PLANNING_MODEL=gpt-3.5-turbo-0125

# Timeout for planning process in milliseconds
TOT_PLANNING_TIMEOUT_MS=5000

# Maximum number of tools after filtering (if more, will use all tools)
TOT_MAX_TOOLS_AFTER_FILTER=10

# ==========================================
# DISCORD BOT CONFIGURATION
# ==========================================
DISCORD_ENABLED=true
DISCORD_TOKEN=your_discord_bot_token_here
DISCORD_CLEANUP_INTERVAL=24
DISCORD_SESSION_TIMEOUT=12

# ==========================================
# MCP (Model Context Protocol) CONFIGURATION
# ==========================================
MCP_ENABLED=true
MCP_AUTH_TOKEN=your_mcp_auth_token_here
MCP_LOG_LEVEL=info

# MCP Server Configurations
MCP_GITHUB_ENABLED=true
MCP_BRAVE_ENABLED=true

# MCP Server API Keys
GITHUB_TOKEN=your_github_personal_access_token_here
BRAVE_API_KEY=your_brave_search_api_key_here

# ==========================================
# DATABASE CONFIGURATION
# ==========================================
DATABASE_URL=your_database_connection_string_here

# ==========================================
# LOGGING & DEBUG CONFIGURATION
# ==========================================
DEBUG=true
LOG_LEVEL=info
LOG_SHOW_TOOLS=true
LOG_SHOW_REQUESTS=true

# ==========================================
# DEVELOPMENT/ADVANCED OPTIONS
# ==========================================

# Disable verbose OpenAI API logs for cleaner output
DISABLE_OPENAI_VERBOSE_LOGS=true

# Enable detailed logging for the ReAct reasoning process
REACT_VERBOSE_LOGGING=true

# ==========================================
# ALTERNATIVE PROVIDER-BASED CONFIGURATION
# ==========================================
# Uncomment these if you want to use the main service's provider-based approach
# instead of direct model specification above

# MODEL=openai
# OPENAI_MODEL=gpt-3.5-turbo-0125
# CLAUDE_MODEL=claude-3-5-sonnet-20241022
# OLLAMA_MODEL=llama3.2:latest
