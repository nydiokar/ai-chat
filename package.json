{
  "name": "them",
  "version": "0.6.6",
  "main": "index.js",
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc -w",
    "start": "node dist/index.js",
    "dev": "ts-node-dev --respawn src/index.ts",
    "bot": "ts-node src/discord-bot.ts",
    "bot:prod": "pm2 start ecosystem.config.cjs --only them-bot",
    "bot:dev": "pm2 start ecosystem.config.cjs --only them-bot-dev",
    "bot:stop:prod": "pm2 stop them-bot",
    "bot:stop:dev": "pm2 stop them-bot-dev",
    "bot:logs:prod": "pm2 logs them-bot",
    "bot:logs:dev": "pm2 logs them-bot-dev",
    "bot:monit": "pm2 monit",
    "prisma:generate": "prisma generate",
    "pretest": "npm run build && npm run db:sync",
    "test:watch": "cross-env NODE_OPTIONS=\"--import tsx\" mocha --watch",
    "test:coverage": "cross-env NODE_OPTIONS=\"--import tsx\" c8 mocha \"src/**/*.test.ts\"",
    "test:unit": "cross-env NODE_OPTIONS=\"--import tsx\" mocha \"src/**/*.test.ts\"",
    "test:ci": "cross-env NODE_OPTIONS=\"--import tsx\" mocha \"src/tests/react-agent.test.ts\" \"src/tests/react-step-parser.test.ts\" \"src/tests/react-tool-handler.test.ts\" \"src/tests/react-trace.test.ts\" \"src/tests/tools/**/*.test.ts\" \"src/tests/tool-chain/tool-chain-executor.test.ts\" \"src/tests/prompt/**/*.test.ts\"",
    "test:react": "cross-env NODE_OPTIONS=\"--import tsx\" mocha \"src/tests/react-agent.test.ts\"",
    "test:tokens": "cross-env NODE_OPTIONS=\"--import tsx\" mocha \"src/features/hot-tokens/services/hot-tokens-service.test.ts\"",
    "test:mcp": "cross-env NODE_OPTIONS=\"--import tsx\" mocha \"src/tools/mcp/**/*.test.ts\"",
    "test:mcp:schema": "cross-env NODE_OPTIONS=\"--import tsx\" mocha \"src/tools/mcp/types/tools.test.ts\"",
    "test:github": "cross-env NODE_OPTIONS=\"--loader ts-node/esm\" ts-node -r tsconfig-paths/register src/features/pulse-mcp/tests/test-github-installation.ts",
    "lint": "eslint src/**/*.{js,ts,jsx,tsx}",
    "lint:fix": "eslint src/**/*.{js,ts,jsx,tsx} --fix",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.{ts,js,json,md}\"",
    "format:check": "prettier --check \"src/**/*.{ts,js,json,md}\"",
    "mcp:tools": "cross-env NODE_OPTIONS=\"--loader ts-node/esm\" ts-node src/tools/mcp/types/tools.test.ts",
    "mcp:status": "cross-env NODE_OPTIONS=\"--loader ts-node/esm\" ts-node src/tools/mcp/dashboard-cli.ts",
    "mcp:dashboard": "cross-env NODE_OPTIONS=\"--loader ts-node/esm\" ts-node src/tools/mcp/start-dashboard.ts",
    "mcp:dashboard:dev": "cross-env NODE_OPTIONS=\"--loader ts-node/esm\" ts-node-dev --respawn src/tools/mcp/start-dashboard.ts",
    "pre-push": "bash scripts/pre-push-check.sh",
    "quality:check": "npm run lint && npm run format:check && npm run typecheck",
    "quality:fix": "npm run lint:fix && npm run format",
    "test:setup": "npx prisma db push --accept-data-loss",
    "db:setup:dev": "cross-env NODE_ENV=development node scripts/manage-db.js setup",
    "db:setup:prod": "cross-env NODE_ENV=production node scripts/manage-db.js setup",
    "db:generate:dev": "cross-env NODE_ENV=development node scripts/manage-db.js generate",
    "db:generate:prod": "cross-env NODE_ENV=production node scripts/manage-db.js generate",
    "db:migrate:dev": "cross-env NODE_ENV=development node scripts/manage-db.js migrate",
    "db:migrate:prod": "cross-env NODE_ENV=production node scripts/manage-db.js migrate",
    "diagnose:github": "node scripts/diagnose-github.js",
    "react": "cross-env DISABLE_OPENAI_VERBOSE_LOGS=true REACT_VERBOSE_LOGGING=true NODE_OPTIONS=\"--loader ts-node/esm\" ts-node scripts/react-cli-tester.ts"
  },
  "bin": {
    "them": "./dist/index.js",
    "mcp-status": "./dist/tools/mcp/dashboard-cli.js",
    "mcp-dashboard": "./dist/tools/mcp/start-dashboard.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.33.1",
    "@discordjs/core": "^2.0.1",
    "@discordjs/rest": "^2.4.3",
    "@kimtaeyoon83/mcp-server-youtube-transcript": "^0.1.1",
    "@modelcontextprotocol/sdk": "^1.1.1",
    "@modelcontextprotocol/server-brave-search": "^0.6.2",
    "@modelcontextprotocol/server-github": "^2025.1.23",
    "@types/node-cache": "^4.1.3",
    "anthropic": "^0.0.0",
    "axios": "^1.7.9",
    "blessed": "^0.1.81",
    "boxen": "^7.1.1",
    "chalk": "^5.3.0",
    "clipboardy": "^4.0.0",
    "commander": "^13.0.0",
    "discord.js": "^14.18.0",
    "dotenv": "^16.4.7",
    "glob": "^11.0.1",
    "inquirer": "^9.2.12",
    "inquirer-autocomplete-prompt": "^3.0.1",
    "inversify": "^7.1.0",
    "js-yaml": "^4.1.1",
    "keyv": "^5.2.3",
    "keyv-file": "^5.1.1",
    "mcp": "^1.3.4",
    "node-cache": "^5.1.2",
    "nodecache": "^0.0.2",
    "ollama": "^0.5.14",
    "openai": "^4.78.1",
    "ora": "^7.0.1",
    "pg": "^8.14.1",
    "pm2": "^6.0.13",
    "reflect-metadata": "^0.2.2",
    "rimraf": "^6.0.1",
    "sinon": "^19.0.2",
    "uuid": "^11.0.5",
    "winston": "^3.17.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@prisma/client": "^6.15.0",
    "@types/blessed": "^0.1.25",
    "@types/chai": "^5.2.1",
    "@types/chai-as-promised": "^8.0.1",
    "@types/inquirer": "^9.0.7",
    "@types/inquirer-autocomplete-prompt": "^3.0.3",
    "@types/jest": "^29.5.14",
    "@types/js-yaml": "^4.0.9",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.14.0",
    "@types/sinon": "^17.0.4",
    "@types/supertest": "^6.0.3",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "c8": "^10.1.3",
    "chai": "^5.0.0",
    "chai-as-promised": "^8.0.1",
    "cross-env": "^7.0.3",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-unused-imports": "^4.0.0",
    "jest": "^29.7.0",
    "mocha": "^10.8.2",
    "mocha-clean": "^1.0.0",
    "postcss": "^8.5.3",
    "prettier": "^3.0.0",
    "prisma": "^6.15.0",
    "sinon-chai": "^4.0.0",
    "supertest": "^7.1.0",
    "tailwindcss": "^4.0.11",
    "ts-jest": "^29.3.1",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.0.0",
    "typescript": "^5.8.3"
  },
  "ts-node": {
    "esm": true
  },
  "type": "module"
}
